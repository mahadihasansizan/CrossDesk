<Window x:Class="DeskRelay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CrossDesk" Icon="CrossDesk.png" Width="1060" Height="820"
 MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}"
 FontFamily="Segoe UI Variable, Segoe UI" Foreground="{DynamicResource Ink}" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F6F6F8"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#202127"/>
  <SolidColorBrush x:Key="Muted" Color="#61636E"/>
  <SolidColorBrush x:Key="Line" Color="#E2E3E8"/>
  <SolidColorBrush x:Key="Accent" Color="#0867D8"/>
  <SolidColorBrush x:Key="AccentTint" Color="#EAF2FF"/>
  <SolidColorBrush x:Key="Success" Color="#227345"/>
  <SolidColorBrush x:Key="Error" Color="#A52A30"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Secondary" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,10"/><Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,6"/></Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="24,32,20,24">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <Image Source="CrossDesk.png" Width="42" Height="42" HorizontalAlignment="Left"/>
     <TextBlock Text="CrossDesk" FontSize="23" FontWeight="SemiBold" Margin="0,14,0,4"/>
     <TextBlock Text="Your desk, connected." Style="{StaticResource Secondary}" FontSize="12"/>
     <Border Background="{StaticResource AccentTint}" CornerRadius="8" Padding="12" Margin="-8,32,-4,0">
      <TextBlock Text="Workspace" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
     </Border>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <TextBlock Text="Always within reach" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Ctrl + Alt + Space" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock Text="Switch control" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,14"/>
     <TextBlock Text="Ctrl + Alt + Esc" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock Text="Return to this PC" Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,24"/>
     <TextBlock Text="Local network · Encrypted" Style="{StaticResource Secondary}" FontSize="11"/>
     <Button x:Name="FirewallButton" Content="Allow local connections" Click="Firewall_Click" Margin="0,12,0,0"/>
     <Button x:Name="UpdateButton" Content="Check for updates" Click="Update_Click" Margin="0,6,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,30,32,24">
    <Grid Margin="0,0,0,24">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="One workspace." FontSize="32" FontWeight="SemiBold"/>
      <TextBlock Text="Move, type, and share between your Windows PCs." Style="{StaticResource Secondary}" Margin="0,7,20,0"/>
     </StackPanel>
     <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="12" Padding="12,7" VerticalAlignment="Top" Margin="0,7,0,0">
      <TextBlock x:Name="ConnectionBadge" Text="Not connected" FontSize="12" FontWeight="SemiBold"/>
     </Border>
    </Grid>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <Grid>
       <TextBlock Text="Your devices" FontSize="18" FontWeight="SemiBold"/>
       <Button x:Name="DisconnectButton" Content="Disconnect" HorizontalAlignment="Right" Padding="12,5" MinHeight="30" Visibility="Collapsed" Click="Disconnect_Click"/>
      </Grid>
      <Grid Margin="0,24,0,20">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel x:Name="LocalDevice" Grid.Column="0">
        <Border Height="108" MaxWidth="240" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="10">
         <StackPanel VerticalAlignment="Center" Margin="14">
          <TextBlock x:Name="LocalName" Text="This PC" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock Text="This computer" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,7,0,0"/>
         </StackPanel>
        </Border>
        <Border Width="46" Height="5" Background="{StaticResource Line}" CornerRadius="2" Margin="0,8,0,0"/>
       </StackPanel>
       <Path Grid.Column="1" Data="M 1,6 L 25,6 M 1,6 L 6,1 M 1,6 L 6,11 M 25,6 L 20,1 M 25,6 L 20,11"
         Stroke="{StaticResource Muted}" StrokeThickness="1.4" Width="26" Height="12" VerticalAlignment="Center"/>
       <StackPanel x:Name="RemoteDevice" Grid.Column="2">
        <Border Height="108" MaxWidth="240" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="10">
         <StackPanel VerticalAlignment="Center" Margin="14">
          <TextBlock x:Name="RemoteName" Text="Your other PC" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock x:Name="RemoteHint" Text="Pair to get started" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,7,0,0"/>
         </StackPanel>
        </Border>
        <Border Width="46" Height="5" Background="{StaticResource Line}" CornerRadius="2" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
       <TextBlock Text="Other computer sits to your" VerticalAlignment="Center" Style="{StaticResource Secondary}"/>
       <ComboBox x:Name="SideBox" Grid.Column="1" SelectedIndex="1" SelectionChanged="Side_Changed" AutomationProperties.Name="Position of other computer">
        <ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/>
       </ComboBox>
      </Grid>
      <TextBlock x:Name="ControlStatus" Text="Pair both computers to share your mouse and keyboard." Style="{StaticResource Secondary}" Margin="0,18,0,0"/>
      <StackPanel x:Name="ControlPanel" Visibility="Collapsed" Margin="0,14,0,0">
       <CheckBox x:Name="KeyboardOnly" Content="Keep the mouse here when switching with the shortcut"/>
       <Button Content="Switch control" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Switch_Click"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="Connect automatically" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Set the same private code on both PCs. CrossDesk finds your other computer and reconnects on your local network." Style="{StaticResource Secondary}" Margin="0,7,0,14"/>
      <TextBlock Text="Shared code · at least 12 characters" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <PasswordBox x:Name="SharedCodeBox" Padding="12,10" MinHeight="40" AutomationProperties.Name="Shared connection code"/>
       <Button x:Name="SaveAutoButton" Grid.Column="1" Content="Save and connect" Margin="10,0,0,0" Click="SaveAuto_Click"/>
      </Grid>
      <CheckBox x:Name="AutoConnectToggle" Content="Automatically connect and reconnect" Margin="0,14,0,6" Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed"/>
      <CheckBox x:Name="StartupToggle" Content="Open CrossDesk when I sign in to Windows" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
      <TextBlock x:Name="AutoStatus" Text="Your code is saved securely for this Windows account." Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border x:Name="PairPanel" Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="Connect another PC" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Open CrossDesk on both computers using the same local network." Style="{StaticResource Secondary}" Margin="0,7,0,18"/>
      <TextBlock Text="Local connection" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,7"/>
      <ComboBox x:Name="AdapterBox" AutomationProperties.Name="Local network connection" DropDownOpened="AdapterBox_Opened"/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,16">
       <Button x:Name="CreateButton" Content="Create pairing code" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
       <Button x:Name="CancelPairButton" Content="Cancel" Margin="10,0,0,0" Visibility="Collapsed" Click="CancelPair_Click"/>
      </StackPanel>
      <StackPanel x:Name="InvitationPanel" Visibility="Collapsed" Margin="0,0,0,18">
       <TextBlock Text="Copy this code to your other PC. Keep this window open." Style="{StaticResource Secondary}" Margin="0,0,0,8"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="InviteCode" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" MaxHeight="80" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Generated pairing code"/>
        <Button Content="Copy" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" Click="Copy_Click"/>
       </Grid>
      </StackPanel>
      <Border Height="1" Background="{StaticResource Line}" Margin="0,2,0,18"/>
      <TextBlock Text="Already have a code?" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="JoinCode" AutomationProperties.Name="Pairing code from other computer" ToolTip="Paste the full pairing code from the other PC"/>
       <Button x:Name="JoinButton" Grid.Column="1" Content="Connect" Margin="10,0,0,0" Click="Join_Click"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border x:Name="SharingPanel" Style="{StaticResource Panel}" Visibility="Collapsed">
     <StackPanel>
      <TextBlock Text="Copy here. Paste there." FontSize="18" FontWeight="SemiBold"/>
      <CheckBox x:Name="ClipboardToggle" Content="Share copied text, images, files, and folders" Margin="0,14,0,7" Checked="Clipboard_Changed" Unchecked="Clipboard_Changed"/>
      <TextBlock Text="File and folder copies ask for approval on the receiving PC." Style="{StaticResource Secondary}" FontSize="12"/>
      <StackPanel Orientation="Horizontal" Margin="0,19,0,16">
       <Button x:Name="SendFilesButton" Content="Send files" Click="SendFiles_Click"/>
       <Button x:Name="SendFolderButton" Content="Send folder" Margin="10,0,0,0" Click="SendFolder_Click"/>
       <Button x:Name="CancelTransferButton" Content="Cancel transfer" Margin="10,0,0,0" Click="CancelTransfer_Click" Visibility="Collapsed"/>
      </StackPanel>
      <ProgressBar x:Name="TransferBar" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
      <TextBlock x:Name="TransferStatus" Text="Ready to share." Style="{StaticResource Secondary}" Margin="0,9,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock x:Name="StatusText" Text="Ready when you are." Style="{StaticResource Secondary}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
